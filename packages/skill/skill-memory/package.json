{
  "name": "@deepseek-ai/dsh-skill-memory",
  "description": "Simple long-term memory skill for the DeepSeek Harness (key/value JSON file).",
  "version": "0.1.0",
  "license": "MIT",
  "private": false,
  "type": "module",
  "publishConfig": {
    "access": "public"
  },
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json"
  },
  "files": [
    "lib/index.js",
    "lib/types/**/*.d.ts"
  ],
  "peerDependencies": {
    "@deepseek-ai/dsh-skill": "workspace:^",
    "@deepseek-ai/cordis": "workspace:^"
  }
}